[Unit]
Description=Root-owned canonical bind for Combo host data
Documentation=file:/opt/combo-dev/current/infra/host/combo-dev/README.md
RequiresMountsFor=/home/xingzheng/data
Before=combo-host-data-mount-check.service opt-combo\x2ddev-state.mount

[Mount]
What=/home/xingzheng/data/combo-host
Where=/var/lib/combo-host-data
Type=none
Options=bind,rw,nodev,nosuid
TimeoutSec=30

[Install]
WantedBy=multi-user.target
