[Unit]
Description=Verify the canonical Combo host-data bind and parent-disk identity
DefaultDependencies=no
Requires=var-lib-combo\x2dhost\x2ddata.mount
After=var-lib-combo\x2dhost\x2ddata.mount
Before=local-fs.target opt-combo\x2ddev-state.mount
Conflicts=umount.target

[Service]
Type=oneshot
ExecStart=/opt/combo-dev/bin/combo-host-data-mount-check
RemainAfterExit=yes
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
