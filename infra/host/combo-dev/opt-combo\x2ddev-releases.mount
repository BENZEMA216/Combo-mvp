[Unit]
Description=Compatibility bind for Combo Test releases
Documentation=file:/opt/combo-dev/current/infra/host/combo-dev/README.md
BindsTo=opt-combo\x2ddev-state.mount
After=opt-combo\x2ddev-state.mount

[Mount]
What=/opt/combo-dev/state/releases
Where=/opt/combo-dev/releases
Type=none
Options=bind,rw,nodev,nosuid,noexec
TimeoutSec=30

[Install]
WantedBy=multi-user.target
