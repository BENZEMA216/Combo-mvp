[Unit]
Description=Fence combo-dev writers on storage, credential, or persistent guard failure
After=k3s.service

[Service]
Type=oneshot
RuntimeDirectory=combo-dev-storage-guard
RuntimeDirectoryMode=0700
ExecStart=/opt/combo-dev/bin/combo-dev-storage-guard
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=combo-dev
StateDirectoryMode=0711
# 故障收敛只写运行目录和持久 marker；数据盘身份固定读取 PID 1 的宿主 mount 视图。
ReadWritePaths=/run /var/lib/combo-dev
