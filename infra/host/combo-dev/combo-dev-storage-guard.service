[Unit]
Description=Fence combo-dev writers on storage, credential, or persistent guard failure
After=k3s.service

[Service]
Type=oneshot
RuntimeDirectory=combo-dev-storage-guard
RuntimeDirectoryMode=0700
ExecStart=/opt/combo-dev/bin/combo-dev-storage-guard
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=combo-dev
StateDirectoryMode=0711
# Failure convergence must still run when every data-backed mount is missing.
ReadWritePaths=/run /var/lib/combo-dev -/home/xingzheng/data/combo-dev -/opt/combo-dev/state -/opt/combo-dev/incoming -/opt/combo-dev/releases -/var/lib/combo-dev/evidence
