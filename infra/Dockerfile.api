# API 与 Worker 共用同一镜像，按 PROCESS=api|worker 在 entrypoint 分叉。
# 同镜像也用于一次性迁移容器；迁移任务覆盖 entrypoint 后运行 db/scripts/migrate.ts。
#
# web 取舍：web 用独立镜像（Dockerfile.web，nginx 托管静态产物 + 反代）。理由——前端是 nginx 静态服务、
# 与 Node 业务进程运行时不同，分镜像更小更清晰；故本镜像只负责 API、Worker 和 migration。

FROM node:24-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.0.9 --activate
# 先拷工作区清单 + 各 package.json，最大化 install 层缓存
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY db ./db
RUN pnpm install --frozen-lockfile=false
# shared 与 Creator Agent protocol 先 build（Authoring 依赖其 dist + .d.ts），再 build API。
RUN pnpm -F @cb/shared build && pnpm -F @cb/creator-agent-protocol build && pnpm -F @cb/authoring build

FROM node:24-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# PROCESS 决定本容器跑哪个进程入口（api 为默认）；migrate 容器在 compose 覆盖 entrypoint。
ENV PROCESS=api
RUN corepack enable && corepack prepare pnpm@11.0.9 --activate
# 工作区清单 + 各包 package.json（--prod install 需要）
COPY --from=build /app/pnpm-workspace.yaml /app/package.json /app/pnpm-lock.yaml* ./
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/creator-agent-protocol/package.json ./packages/creator-agent-protocol/package.json
COPY --from=build /app/apps/authoring/package.json ./apps/authoring/package.json
COPY --from=build /app/db/package.json ./db/package.json
RUN pnpm install --prod --frozen-lockfile=false
# 产物：shared dist + api dist + 迁移运行时白名单（migrate 容器用 --experimental-strip-types 直跑 TS）。
# 不复制完整 db 源码树，避免把测试、fixture 或开发辅助文件带入生产镜像。
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/creator-agent-protocol/dist ./packages/creator-agent-protocol/dist
COPY --from=build /app/apps/authoring/dist ./apps/authoring/dist
COPY --from=build /app/db/migrations ./db/migrations
COPY --from=build /app/db/scripts/migrate.ts ./db/scripts/migrate.ts
COPY --from=build /app/db/scripts/provision-app-roles.ts ./db/scripts/provision-app-roles.ts
# entrypoint 分叉脚本
COPY infra/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
EXPOSE 3000
# 默认走 entrypoint 按 PROCESS 分叉；compose 的 migrate 容器用显式 entrypoint 覆盖。
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
