{
  "name": "@cb/creator-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Creator Worker 的可靠执行 pump 与唯一运行时组合根",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "typecheck:test": "tsc -p tsconfig.vitest.json",
    "pretest": "pnpm -F @cb/creator-agent-protocol build && pnpm -F @cb/creator-agent-broker-journal build && pnpm -F @cb/creator-worker-broker-client build && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@cb/creator-agent-broker-journal": "workspace:*",
    "@cb/creator-agent-protocol": "workspace:*",
    "@cb/creator-worker-broker-client": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "ws": "8.21.0"
  }
}
