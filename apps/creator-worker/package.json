{
  "name": "@cb/creator-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Combo Creator Worker 体验版：通过 Codex app-server 把一个脱敏 Project 暂时变成只读、多轮、仅本机可访问的 Agent。",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "combo-creator-worker": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "typecheck:test": "tsc -p tsconfig.vitest.json",
    "dev": "tsc -b && node dist/cli.js",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
