{
  "name": "@cb/creator-worker-broker-client",
  "version": "0.0.0",
  "private": true,
  "description": "Creator Worker 的持久 Broker transport 与 WebSocket driver",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite-repository": {
      "types": "./dist/sqlite-repository.d.ts",
      "default": "./dist/sqlite-repository.js"
    },
    "./websocket-driver": {
      "types": "./dist/websocket-driver.d.ts",
      "default": "./dist/websocket-driver.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "typecheck:test": "tsc -p tsconfig.vitest.json",
    "pretest": "pnpm -F @cb/creator-agent-protocol build && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@cb/creator-agent-protocol": "workspace:*",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
