{
  "name": "@cb/creator-worker-broker-client",
  "version": "0.0.0",
  "private": true,
  "description": "Creator Worker 的 outbound Broker WebSocket transport 与 durable port。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "typecheck:test": "tsc -p tsconfig.vitest.json",
    "pretest": "pnpm -F @cb/creator-agent-protocol build && pnpm -F @cb/creator-agent-broker-journal build && pnpm -F @cb/agent-gateway build && tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@cb/creator-agent-broker-journal": "workspace:*",
    "@cb/creator-agent-protocol": "workspace:*",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cb/agent-gateway": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/ws": "8.18.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
