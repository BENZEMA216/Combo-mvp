{
  "openapi": "3.1.0",
  "info": {
    "title": "Combo Creator-hosted Agent VNext API",
    "version": "1.0.0-alpha.1",
    "description": "Creator/Consumer HTTP contract. All IDs are control-plane data and never model input."
  },
  "servers": [{ "url": "https://test.example.invalid" }],
  "security": [{ "creatorOAuth": [] }],
  "paths": {
    "/v1/creator/snapshot-uploads": {
      "post": {
        "operationId": "createSnapshotUpload",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SnapshotUploadCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建绑定对象和校验和的上传会话",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SnapshotUploadCreateResponse" }
              }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/creator/snapshot-uploads/{uploadId}:complete": {
      "post": {
        "operationId": "completeSnapshotUpload",
        "parameters": [
          {
            "name": "uploadId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SnapshotUploadCompleteRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "上传进入 VERIFYING",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SnapshotUploadView" }
              }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/creator/agents": {
      "post": {
        "operationId": "createAgent",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateAgentRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "已创建 Agent",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AgentView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/creator/agents/{agentId}/versions": {
      "post": {
        "operationId": "createAgentVersion",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAgentVersionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建或复用不可变 AgentVersion",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AgentVersionView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/creator/agents/{agentId}/versions/{versionId}": {
      "get": {
        "operationId": "getAgentVersion",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "不可变 AgentVersion 视图",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AgentVersionView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/creator/agents/{agentId}/deployment": {
      "put": {
        "operationId": "updateAgentDeployment",
        "parameters": [
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "pattern": "^\"generation-[0-9]+\"$" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/DeploymentMutation" } }
          }
        },
        "responses": {
          "202": {
            "description": "已接受 desired state；observed state 由 Worker 事实更新",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/DeploymentView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/public/agents/{slug}/conversations": {
      "post": {
        "operationId": "createConversation",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateConversationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation 已原子固定 serving AgentVersion",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ConversationView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{conversationId}": {
      "get": {
        "operationId": "getConversationTranscript",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "权威 transcript 与最新 durable cursor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConversationTranscript" }
              }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{conversationId}/messages": {
      "post": {
        "operationId": "sendConversationMessage",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendConversationMessageRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "请求与 Outbox 已在 PostgreSQL 原子提交",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvocationAcceptedResponse" }
              }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/conversations/{conversationId}/events": {
      "get": {
        "operationId": "streamConversationEvents",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE；delta 可丢，terminal/final 可从 PostgreSQL 恢复",
            "content": {
              "text/event-stream": { "schema": { "$ref": "#/components/schemas/ConsumerEvent" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/invocations/{invocationId}": {
      "get": {
        "operationId": "getInvocation",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          {
            "name": "invocationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Invocation 当前权威状态",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InvocationView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/invocations/{invocationId}:cancel": {
      "post": {
        "operationId": "cancelInvocation",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          {
            "name": "invocationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CancelInvocationRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已记录取消请求；不等同于已取消",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InvocationView" } }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/invocations/{invocationId}:retry": {
      "post": {
        "operationId": "retryInvocation",
        "security": [{ "consumerSession": [] }],
        "parameters": [
          {
            "name": "invocationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RetryInvocationRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已创建关联的新 Invocation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvocationAcceptedResponse" }
              }
            }
          },
          "default": {
            "description": "稳定错误信封",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VnextErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "creatorOAuth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "scopes": {}
          }
        }
      },
      "consumerSession": { "type": "apiKey", "in": "cookie", "name": "__Host-cb_session" }
    },
    "schemas": {
      "SnapshotUploadCreateRequest": {
        "type": "object",
        "properties": {
          "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "archiveDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "compressedBytes": { "type": "integer", "minimum": 1, "maximum": 52428800 },
          "expandedBytes": { "type": "integer", "minimum": 1, "maximum": 209715200 },
          "fileCount": { "type": "integer", "minimum": 1, "maximum": 2000 }
        },
        "required": [
          "snapshotDigest",
          "archiveDigest",
          "compressedBytes",
          "expandedBytes",
          "fileCount"
        ],
        "additionalProperties": false
      },
      "SnapshotUploadCreateResponse": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string", "enum": ["combo.creator-agent-http/1"] },
          "uploadId": { "type": "string", "format": "uuid" },
          "state": { "type": "string", "enum": ["CREATED"] },
          "putUrl": { "type": "string", "format": "uri" },
          "requiredHeaders": {
            "type": "object",
            "properties": {
              "contentLength": { "type": "integer", "minimum": 1, "maximum": 53477376 },
              "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "required": ["contentLength", "checksumSha256"],
            "additionalProperties": false
          },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["protocol", "uploadId", "state", "putUrl", "requiredHeaders", "expiresAt"],
        "additionalProperties": false
      },
      "SnapshotUploadCompleteRequest": {
        "type": "object",
        "properties": {
          "cipherDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "encryptedBytes": { "type": "integer", "minimum": 1, "maximum": 53477376 }
        },
        "required": ["cipherDigest", "encryptedBytes"],
        "additionalProperties": false
      },
      "SnapshotUploadView": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string", "enum": ["combo.creator-agent-http/1"] },
          "uploadId": { "type": "string", "format": "uuid" },
          "state": {
            "type": "string",
            "enum": ["CREATED", "UPLOADED", "VERIFYING", "VERIFIED", "REJECTED", "EXPIRED"]
          },
          "snapshotId": { "type": "string", "format": "uuid", "nullable": true },
          "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "errorCode": { "type": "string", "maxLength": 128, "nullable": true },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "protocol",
          "uploadId",
          "state",
          "snapshotId",
          "snapshotDigest",
          "errorCode",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "CreateAgentRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        },
        "required": ["name", "description"],
        "additionalProperties": false
      },
      "AgentView": {
        "type": "object",
        "properties": {
          "protocol": { "type": "string", "enum": ["combo.creator-agent-http/1"] },
          "agentId": { "type": "string", "format": "uuid" },
          "publicSlug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])?$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "lifecycle": { "type": "string", "enum": ["ACTIVE", "ARCHIVED"] },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "protocol",
          "agentId",
          "publicSlug",
          "name",
          "description",
          "lifecycle",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "CreateAgentVersionRequest": {
        "type": "object",
        "properties": {
          "verifiedSnapshotId": { "type": "string", "format": "uuid" },
          "manifest": {
            "type": "object",
            "properties": {
              "protocol": { "type": "string", "enum": ["combo.agent-version-manifest/1"] },
              "schemaVersion": { "type": "number", "enum": [1] },
              "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "behaviorContract": {
                "type": "object",
                "properties": {
                  "schemaVersion": { "type": "number", "enum": [1] },
                  "role": { "type": "string", "minLength": 1 },
                  "objective": { "type": "string", "minLength": 1 },
                  "developerInstructions": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "minItems": 1,
                    "maxItems": 32
                  },
                  "language": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
                  "evidencePolicy": {
                    "type": "string",
                    "enum": ["none", "cite-relative-path-when-used"]
                  },
                  "answerStyle": { "type": "string", "enum": ["plain", "conclusion-evidence-risk"] }
                },
                "required": [
                  "schemaVersion",
                  "role",
                  "objective",
                  "developerInstructions",
                  "language",
                  "evidencePolicy",
                  "answerStyle"
                ],
                "additionalProperties": false
              },
              "runtimePolicy": {
                "type": "object",
                "properties": {
                  "schemaVersion": { "type": "number", "enum": [1] },
                  "isolation": { "type": "string", "enum": ["conversation-vm-required"] },
                  "filesystem": {
                    "type": "object",
                    "properties": {
                      "context": { "type": "string", "enum": ["read-only-noexec"] },
                      "scratch": { "type": "string", "enum": ["conversation-only"] },
                      "hostMounts": { "type": "string", "enum": ["forbidden"] }
                    },
                    "required": ["context", "scratch", "hostMounts"],
                    "additionalProperties": false
                  },
                  "contextTools": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": [
                      { "type": "string", "enum": ["read_context"] },
                      { "type": "string", "enum": ["list_context"] },
                      { "type": "string", "enum": ["search_context"] }
                    ]
                  },
                  "projectExecution": { "type": "string", "enum": ["forbidden"] },
                  "network": { "type": "string", "enum": ["model-proxy-only"] },
                  "externalTools": { "type": "string", "enum": ["disabled"] },
                  "hostCredentials": { "type": "string", "enum": ["forbidden"] },
                  "maxTurnSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
                  "maxConversationTurns": { "type": "integer", "minimum": 1, "maximum": 20 },
                  "maxVisibleHistoryBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
                  "maxActiveTurns": { "type": "number", "enum": [1] },
                  "resolvedModel": { "type": "string", "minLength": 1 },
                  "reasoningEffort": {
                    "type": "string",
                    "enum": ["low", "medium", "high", "xhigh"]
                  }
                },
                "required": [
                  "schemaVersion",
                  "isolation",
                  "filesystem",
                  "contextTools",
                  "projectExecution",
                  "network",
                  "externalTools",
                  "hostCredentials",
                  "maxTurnSeconds",
                  "maxConversationTurns",
                  "maxVisibleHistoryBytes",
                  "maxActiveTurns",
                  "resolvedModel",
                  "reasoningEffort"
                ],
                "additionalProperties": false
              },
              "ioContract": {
                "type": "object",
                "properties": {
                  "schemaVersion": { "type": "number", "enum": [1] },
                  "input": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["text"] },
                      "maxUtf8Bytes": { "type": "number", "enum": [16384] }
                    },
                    "required": ["type", "maxUtf8Bytes"],
                    "additionalProperties": false
                  },
                  "output": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["text"] },
                      "maxUtf8Bytes": { "type": "number", "enum": [32768] }
                    },
                    "required": ["type", "maxUtf8Bytes"],
                    "additionalProperties": false
                  },
                  "files": { "type": "boolean", "enum": [false] },
                  "actions": { "type": "boolean", "enum": [false] },
                  "rawReasoning": { "type": "boolean", "enum": [false] }
                },
                "required": [
                  "schemaVersion",
                  "input",
                  "output",
                  "files",
                  "actions",
                  "rawReasoning"
                ],
                "additionalProperties": false
              },
              "codexRuntime": {
                "type": "object",
                "properties": {
                  "version": { "type": "string", "minLength": 1 },
                  "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                  "protocolSchemaDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
                  "platform": { "type": "string", "enum": ["linux-arm64"] }
                },
                "required": ["version", "artifactDigest", "protocolSchemaDigest", "platform"],
                "additionalProperties": false
