{
  "name": "@cb/creator-agent-persistence",
  "version": "0.0.0",
  "private": true,
  "description": "Creator Agent Draft 与不可变 Version 的本地 SQLite catalog",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false",
    "typecheck:test": "tsc -p tsconfig.vitest.json",
    "pretest": "pnpm -F @cb/creator-agent-protocol build && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@cb/creator-agent-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
